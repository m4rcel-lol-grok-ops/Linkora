# Linkora Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://linkora:linkora_secret@postgres:5432/linkora
# Or individual:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=linkora
# DB_USER=linkora
# DB_PASSWORD=linkora_secret

# Session
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE_MS=1209600000

# Application
BASE_URL=http://localhost:3000
TRUST_PROXY=1

# Uploads
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# Logging
LOG_LEVEL=info

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TWEET_RATE_LIMIT_MAX=30

# Optional future
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=noreply@linkora.example.com
