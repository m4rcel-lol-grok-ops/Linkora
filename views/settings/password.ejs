<%- include('../partials/head') %>

<div class="settings-layout">
  <nav class="settings-nav">
    <a href="/settings/account">Account</a>
    <a href="/settings/profile">Profile</a>
    <a href="/settings/password" class="active">Password</a>
    <a href="/settings/privacy">Privacy</a>
    <a href="/settings/design">Design</a>
  </nav>
  <div class="settings-content">
    <h2 style="margin-top:0;font-weight:300;">Password</h2>
    <% if (typeof error !== 'undefined' && error) { %><div class="form-error"><%= error %></div><% } %>
    <form method="post" action="/settings/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="current_password">Current password</label>
        <input type="password" id="current_password" name="current_password" required>
      </div>
      <div class="form-group">
        <label for="new_password">New password</label>
        <input type="password" id="new_password" name="new_password" required minlength="8">
      </div>
      <button type="submit" class="btn-primary" style="width:auto;padding:0 20px;">Change password</button>
    </form>
  </div>
</div>

<%- include('../partials/foot') %>
