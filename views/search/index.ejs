<%- include('../partials/head') %>

<div class="dashboard">
  <main class="dashboard-center" style="max-width:590px;margin:0 auto;">
    <div class="module" style="padding:12px;">
      <form action="/search" method="get">
        <input type="text" name="q" value="<%= q || '' %>" placeholder="Search Linkora" style="width:100%;height:36px;padding:0 12px;border:1px solid var(--border-dark);border-radius:18px;font-size:14px;">
      </form>
    </div>

    <% if (q) { %>
      <% if (users && users.length) { %>
        <div class="module">
          <div class="module-header">People</div>
          <div class="module-body">
            <% users.forEach(function(u) { %>
              <div class="wtf-item">
                <img class="wtf-avatar" src="<%= u.avatar_url || '/images/default-avatar.svg' %>" alt="">
                <div class="wtf-info">
                  <a href="/<%= u.username %>" class="wtf-name"><%= u.display_name %></a>
                  <span class="wtf-username">@<%= u.username %></span>
                  <% if (u.bio) { %><div style="font-size:12px;color:var(--muted-text);margin-top:2px;"><%= u.bio %></div><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="timeline">
        <div class="timeline-header">Tweets</div>
        <% if (tweets && tweets.length) { %>
          <% tweets.forEach(function(tweet) { %>
            <%- include('../partials/tweet', { tweet: tweet }) %>
          <% }); %>
        <% } else { %>
          <div class="empty-state">No Tweets found for “<%= q %>”</div>
        <% } %>
      </div>
    <% } else { %>
      <div class="empty-state">Try searching for people, topics, or keywords</div>
    <% } %>
  </main>
</div>

<%- include('../partials/foot') %>
